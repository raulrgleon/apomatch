DATABASE_URL=postgresql://apomatch:change-me@localhost:5432/apomatch?schema=public
APP_ORIGIN=http://localhost:3000
# Set a random value of at least 32 characters. Never commit actual secrets.
SESSION_SECRET=replace-with-at-least-32-random-characters
# Optional, disabled by default. Use a private trusted Ollama endpoint only.
AI_PROVIDER=disabled
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b

POSTGRES_PASSWORD=replace-with-a-random-url-safe-password
NEXT_TELEMETRY_DISABLED=1
